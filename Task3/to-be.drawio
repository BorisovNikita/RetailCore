        <UserObject label="&lt;font style=&quot;font-size:12px;&quot;&gt;&lt;i&gt;«system»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Маркетплейсы&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Внешние каналы продаж" plantUmlId="c4_7" plantUmlBaseStyle="rounded=0;html=1;whiteSpace=wrap;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;strokeWidth=0.5;fontSize=14;verticalAlign=top;spacingTop=6;" plantUmlBaseValue="&lt;font style=&quot;font-size:12px;&quot;&gt;&lt;i&gt;«system»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Маркетплейсы&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Внешние каналы продаж" id="rPhHG_u_Q1VmDP-YIoIa-9">
          <mxCell parent="rPhHG_u_Q1VmDP-YIoIa-1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;strokeWidth=0.5;fontSize=14;verticalAlign=top;spacingTop=6;" vertex="1">
