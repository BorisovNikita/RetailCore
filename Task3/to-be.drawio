<mxfile host="app.diagrams.net">
  <diagram name="Страница-1" id="Nk8Ip05idGBbDguPyeVg">
    <mxGraphModel dx="6367" dy="2503" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml RetailCore-TO-BE-C4\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml\n\n&#39; ============================================================\n&#39; НАСТРОЙКИ\n&#39; ============================================================\ntitle RetailCore — TO-BE первого этапа (C4 Container)\n\nLAYOUT_LEFT_RIGHT()\nHIDE_STEREOTYPE()\n\nUpdateElementStyle(\&quot;person\&quot;, $bgColor=\&quot;#08427B\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#073B6F\&quot;)\nUpdateElementStyle(\&quot;external_system\&quot;, $bgColor=\&quot;#999999\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#7A7A7A\&quot;)\nUpdateElementStyle(\&quot;system\&quot;, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B5394\&quot;)\nUpdateElementStyle(\&quot;container\&quot;, $bgColor=\&quot;#438DD5\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#3C7FC0\&quot;)\nUpdateElementStyle(\&quot;database\&quot;, $bgColor=\&quot;#438DD5\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#3C7FC0\&quot;)\nUpdateElementStyle(\&quot;queue\&quot;, $bgColor=\&quot;#438DD5\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#3C7FC0\&quot;)\n\n&#39; ============================================================\n&#39; ВНЕШНИЕ УЧАСТНИКИ\n&#39; ============================================================\nPerson(customer, \&quot;Клиент\&quot;, \&quot;Оформляет заказ, получает уведомления\&quot;)\nPerson(support, \&quot;Оператор поддержки\&quot;, \&quot;Работает через единую карточку заказа\&quot;)\nPerson(business, \&quot;Бизнес-пользователи\&quot;, \&quot;Маркетинг, продажи, логистика, финансы\&quot;)\nPerson(ops, \&quot;Операционный блок\&quot;, \&quot;Настраивает приоритеты доставки, разбирает исключения\&quot;)\n\nSystem_Ext(marketplaces, \&quot;Маркетплейсы\&quot;, \&quot;Внешние каналы продаж\&quot;)\nSystem_Ext(payments, \&quot;Платёжные провайдеры\&quot;, \&quot;Создание сессий, возвраты\&quot;)\nSystem_Ext(delivery, \&quot;Службы доставки\&quot;, \&quot;Резервирование слотов, статусы\&quot;)\nSystem_Ext(bi, \&quot;BI / отчёты\&quot;, \&quot;Потребители витрин аналитики\&quot;)\n\n&#39; ============================================================\n&#39; ГРАНИЦА СИСТЕМЫ RETAILCORE TO-BE\n&#39; ============================================================\nSystem_Boundary(retailcore_tobe, \&quot;RetailCore TO-BE (первый этап)\&quot;) {\n\n  Container(channels, \&quot;Интернет-магазин и мобильные каналы\&quot;, \&quot;Web / Mobile\&quot;, \&quot;Витрина и оформление заказа\&quot;)\n\n  &#39; ---------- ЯДРО (не меняется) ----------\n  Container_Boundary(core_unchanged, \&quot;Ядро (не меняется на этом этапе)\&quot;) {\n    Container(orderapi, \&quot;Checkout / Order API\&quot;, \&quot;Java\&quot;, \&quot;Точка входа заказов\&quot;)\n    Container(processing, \&quot;Order Processing\&quot;, \&quot;Java\&quot;, \&quot;Создание и пост-обработка заказа\&quot;)\n    Container(pricing, \&quot;Pricing &amp; Promo Logic\&quot;, \&quot;Java + Oracle packages\&quot;, \&quot;Расчёт цены, скидок, промо\&quot;)\n    Container(payment_orch, \&quot;Payment Orchestration\&quot;, \&quot;Java\&quot;, \&quot;Платёжные сессии\&quot;)\n    Container(delivery_routing, \&quot;Delivery Routing\&quot;, \&quot;Java + Oracle\&quot;, \&quot;Выбор маршрута доставки\&quot;)\n    ContainerDb(oracle, \&quot;Oracle\&quot;, \&quot;СУБД\&quot;, \&quot;Транзакционные данные + бизнес-логика + staging\&quot;)\n  }\n\n  &#39; ---------- НОВЫЕ КОМПОНЕНТЫ ----------\n  Container_Boundary(new_components, \&quot;Новые компоненты первого этапа\&quot;) {\n    ContainerQueue(event_layer, \&quot;Слой событий заказа\&quot;, \&quot;Очередь / шина\&quot;, \&quot;Канонический поток бизнес-событий заказа, статусов, оплаты, доставки\&quot;)\n    Container(read_model, \&quot;Read-model карточки заказа\&quot;, \&quot;Сервис + хранилище\&quot;, \&quot;Единое представление заказа с историей и статусами\&quot;)\n    Container(status_model, \&quot;Двухуровневая модель статусов\&quot;, \&quot;Сервис\&quot;, \&quot;Клиентский + внутренний статус, журнал переходов\&quot;)\n    Container(notifications, \&quot;Сервис уведомлений\&quot;, \&quot;Сервис\&quot;, \&quot;Доставка уведомлений с повторами и журналом\&quot;)\n    Container(acl_logistics, \&quot;ACL для логистики\&quot;, \&quot;Сервис\&quot;, \&quot;Единый контракт, retry, идемпотентность\&quot;)\n    Container(analytics_marts, \&quot;Витрины аналитики\&quot;, \&quot;Хранилище + задания\&quot;, \&quot;Витрины из событий и read-model\&quot;)\n  }\n\n  &#39; ---------- ИЗМЕНЯЕМЫЕ КОМПОНЕНТЫ ----------\n  Container(admin_tools, \&quot;Admin / Support tools\&quot;, \&quot;Web\&quot;, \&quot;Работа через read-model, аудит ручных действий\&quot;)\n}\n\n&#39; ============================================================\n&#39; ПОТОКИ: КЛИЕНТСКИЕ И КАНАЛЬНЫЕ\n&#39; ============================================================\nRel(customer, channels, \&quot;Оформляет заказ\&quot;, \&quot;HTTPS\&quot;)\nRel(channels, orderapi, \&quot;create / update order\&quot;, \&quot;REST\&quot;)\nRel(marketplaces, orderapi, \&quot;Заказы, обновления\&quot;, \&quot;REST / batch\&quot;)\n\n&#39; ============================================================\n&#39; ВНУТРИ ЯДРА (не меняется)\n&#39; ============================================================\nRel(orderapi, pricing, \&quot;Расчёт цены\&quot;, \&quot;in-process\&quot;)\nRel(orderapi, processing, \&quot;Создание заказа\&quot;, \&quot;in-process\&quot;)\nRel(processing, payment_orch, \&quot;Инициация оплаты\&quot;, \&quot;in-process\&quot;)\nRel(processing, delivery_routing, \&quot;Выбор доставки\&quot;, \&quot;in-process\&quot;)\n\n&#39; ============================================================\n&#39; ВНЕШНИЕ ИНТЕГРАЦИИ (через ACL)\n&#39; ============================================================\nRel(delivery_routing, acl_logistics, \&quot;Передача заказа в логистику\&quot;, \&quot;sync / async\&quot;)\nRel(acl_logistics, delivery, \&quot;Резервирование слота\&quot;, \&quot;REST / batch, retry\&quot;)\nRel(payment_orch, payments, \&quot;Создание сессии\&quot;, \&quot;REST\&quot;)\n\n&#39; ============================================================\n&#39; СВЯЗЬ С ORACLE (ядро)\n&#39; ============================================================\nRel(pricing, oracle, \&quot;Правила, промо\&quot;, \&quot;JDBC / packages\&quot;)\nRel(processing, oracle, \&quot;Заказ, резерв, staging\&quot;, \&quot;JDBC\&quot;)\nRel(payment_orch, oracle, \&quot;payment_session_id\&quot;, \&quot;JDBC\&quot;)\nRel(delivery_routing, oracle, \&quot;Правила маршрутизации\&quot;, \&quot;JDBC\&quot;)\nRel(acl_logistics, oracle, \&quot;Чтение правил и партнёров\&quot;, \&quot;JDBC\&quot;)\n\n&#39; ============================================================\n&#39; НОВЫЕ ПОТОКИ: СОБЫТИЯ\n&#39; ============================================================\nRel(processing, event_layer, \&quot;Публикация событий заказа\&quot;, \&quot;async\&quot;)\nRel(payment_orch, event_layer, \&quot;Публикация событий оплаты\&quot;, \&quot;async\&quot;)\nRel(delivery_routing, event_layer, \&quot;Публикация событий доставки\&quot;, \&quot;async\&quot;)\nRel(acl_logistics, event_layer, \&quot;Публикация статусов логистики\&quot;, \&quot;async\&quot;)\n\n&#39; ============================================================\n&#39; НОВЫЕ ПОТОКИ: READ-MODEL И СТАТУСЫ\n&#39; ============================================================\nRel(event_layer, read_model, \&quot;Обновление модели чтения\&quot;, \&quot;async\&quot;)\nRel(event_layer, status_model, \&quot;Обновление статусов\&quot;, \&quot;async\&quot;)\nRel(event_layer, notifications, \&quot;Триггеры уведомлений\&quot;, \&quot;async\&quot;)\nRel(event_layer, analytics_marts, \&quot;Наполнение витрин\&quot;, \&quot;async / batch\&quot;)\n\n&#39; ============================================================\n&#39; ПОТРЕБИТЕЛИ НОВЫХ КОМПОНЕНТОВ\n&#39; ============================================================\nRel(support, admin_tools, \&quot;Разбор обращений\&quot;, \&quot;UI\&quot;)\nRel(admin_tools, read_model, \&quot;Чтение карточки заказа\&quot;, \&quot;API\&quot;)\nRel(admin_tools, status_model, \&quot;Просмотр и аудит статусов\&quot;, \&quot;API\&quot;)\nRel(notifications, customer, \&quot;Уведомления о статусе\&quot;, \&quot;email / push\&quot;)\n\nRel(bi, analytics_marts, \&quot;Отчётные запросы\&quot;, \&quot;SQL\&quot;)\nRel(business, bi, \&quot;Управленческие отчёты\&quot;, \&quot;UI\&quot;)\n\nRel(ops, acl_logistics, \&quot;Настройка приоритетов\&quot;, \&quot;UI / config\&quot;)\n\n&#39; ============================================================\n&#39; СОХРАНЯЕМЫЕ ЛЕГАСИ-ЭЛЕМЕНТЫ\n&#39; ============================================================\nContainer(dotnet_legacy, \&quot;.NET integration service (легаси)\&quot;, \&quot;.NET\&quot;, \&quot;Сохраняется для части партнёрских сценариев вне первого этапа\&quot;)\nRel(dotnet_legacy, oracle, \&quot;staging / shared tables\&quot;, \&quot;обмен через БД\&quot;)\nRel(dotnet_legacy, delivery, \&quot;Часть партнёрских интеграций\&quot;, \&quot;REST / batch\&quot;)\n\nContainer(python_legacy, \&quot;Python analytics jobs (легаси)\&quot;, \&quot;Python\&quot;, \&quot;Сохраняется до полного перехода аналитики на витрины\&quot;)\nRel(python_legacy, oracle, \&quot;Прямые выборки (сокращаются)\&quot;, \&quot;SQL\&quot;)\n\n&#39; ============================================================\n&#39; ПРИМЕЧАНИЯ\n&#39; ============================================================\nnote right of core_unchanged\n  **Ядро первого этапа не меняется**\n  — checkout, pricing, payment orchestration\n  — логика в Oracle packages\n  — синхронные вызовы остаются\nend note\n\nnote bottom of event_layer\n  **Ключевая точка трансформации**\n  — канонический поток событий заказа\n  — основа для read-model, аналитики, уведомлений\n  — публикация после транзакции\nend note\n\nnote bottom of read_model\n  **Модель чтения для поддержки**\n  — единая карточка заказа\n  — история и статусы\n  — не блокирует ядро\nend note\n\nnote bottom of acl_logistics\n  **ACL для логистики**\n  — единый контракт\n  — retry и идемпотентность\n  — снижение дублей и ручных разборов\nend note\n\nnote top of dotnet_legacy\n  **Легаси, не трогаем на этом этапе**\n  — обслуживает часть партнёров\n  — замена отложена\n  — обмен через staging остаётся\nend note\n\nnote top of python_legacy\n  **Легаси-аналитика**\n  — постепенно заменяется витринами\n  — прямые выборки из Oracle сокращаются\n  — полный отказ отложен\nend note\n\nSHOW_LEGEND()\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rPhHG_u_Q1VmDP-YIoIa-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
