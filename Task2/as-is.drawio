<mxfile host="app.diagrams.net">
  <diagram name="Страница-1" id="x9kz_8LsxZn2TjERPXbT">
    <mxGraphModel dx="3184" dy="1252" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml RetailCore-AS-IS-C4\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml\n\n&#39; ============================================================\n&#39; НАСТРОЙКИ\n&#39; ============================================================\ntitle RetailCore — AS-IS (C4 Container)\n\nLAYOUT_LEFT_RIGHT()\nHIDE_STEREOTYPE()\n\nUpdateElementStyle(\&quot;person\&quot;, $bgColor=\&quot;#08427B\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#073B6F\&quot;)\nUpdateElementStyle(\&quot;external_system\&quot;, $bgColor=\&quot;#999999\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#7A7A7A\&quot;)\nUpdateElementStyle(\&quot;system\&quot;, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B5394\&quot;)\nUpdateElementStyle(\&quot;container\&quot;, $bgColor=\&quot;#438DD5\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#3C7FC0\&quot;)\nUpdateElementStyle(\&quot;database\&quot;, $bgColor=\&quot;#438DD5\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#3C7FC0\&quot;)\nUpdateElementStyle(\&quot;queue\&quot;, $bgColor=\&quot;#438DD5\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#3C7FC0\&quot;)\n\n&#39; ============================================================\n&#39; ВНЕШНИЕ УЧАСТНИКИ\n&#39; ============================================================\nPerson(customer, \&quot;Клиент\&quot;, \&quot;Оформляет заказ, следит за статусом\&quot;)\nPerson(support, \&quot;Оператор поддержки\&quot;, \&quot;Разбирает обращения, выполняет ручные действия\&quot;)\nPerson(business, \&quot;Бизнес-пользователи\&quot;, \&quot;Маркетинг, продажи, логистика, финансы\&quot;)\nPerson(ops, \&quot;Операционный блок\&quot;, \&quot;Настраивает приоритеты доставки, разбирает исключения\&quot;)\n\nSystem_Ext(marketplaces, \&quot;Маркетплейсы\&quot;, \&quot;Внешние каналы продаж, обмен заказами и статусами\&quot;)\nSystem_Ext(payments, \&quot;Платёжные провайдеры\&quot;, \&quot;Создание платёжных сессий, возвраты\&quot;)\nSystem_Ext(delivery, \&quot;Службы доставки\&quot;, \&quot;Резервирование слотов, статусы доставки\&quot;)\nSystem_Ext(bi, \&quot;BI / отчёты\&quot;, \&quot;Внутренние аналитические системы и отчётность\&quot;)\n\n&#39; ============================================================\n&#39; ГРАНИЦА СИСТЕМЫ RETAILCORE\n&#39; ============================================================\nSystem_Boundary(retailcore, \&quot;RetailCore AS-IS\&quot;) {\n\n  Container(channels, \&quot;Интернет-магазин и мобильные каналы\&quot;, \&quot;Web / Mobile\&quot;, \&quot;Витрина и оформление заказа\&quot;)\n\n  Container_Boundary(monolith, \&quot;Java-монолит — центральный контур обработки заказов\&quot;) {\n    Container(orderapi, \&quot;Checkout / Order API\&quot;, \&quot;Java\&quot;, \&quot;Точка входа заказов, приём из каналов\&quot;)\n    Container(processing, \&quot;Order Processing\&quot;, \&quot;Java\&quot;, \&quot;Создание, резервирование и пост-обработка заказа\&quot;)\n    Container(pricing, \&quot;Pricing &amp; Promo Logic\&quot;, \&quot;Java + Oracle packages\&quot;, \&quot;Расчёт цены, скидок, промо; fallback на legacy-логику\&quot;)\n    Container(statuses, \&quot;Status Management\&quot;, \&quot;Java + batch + admin\&quot;, \&quot;Жизненный цикл заказа, переходы между состояниями\&quot;)\n    Container(payment_orch, \&quot;Payment Orchestration\&quot;, \&quot;Java\&quot;, \&quot;Создание платёжных сессий, взаимодействие с провайдерами\&quot;)\n    Container(delivery_routing, \&quot;Delivery Routing\&quot;, \&quot;Java + Oracle\&quot;, \&quot;Выбор маршрута и партнёра доставки\&quot;)\n  }\n\n  ContainerDb(oracle, \&quot;Oracle\&quot;, \&quot;СУБД\&quot;, \&quot;Операционные данные + бизнес-логика (packages) + интеграционный слой (staging)\&quot;)\n\n  Container(dotnet, \&quot;.NET integration service\&quot;, \&quot;.NET\&quot;, \&quot;Партнёрские интеграции через staging-таблицы\&quot;)\n  Container(python_jobs, \&quot;Python analytics jobs\&quot;, \&quot;Python\&quot;, \&quot;Выгрузки, витрины, аналитические задания\&quot;)\n\n  ContainerQueue(async_layer, \&quot;Async / batch exchange\&quot;, \&quot;Очереди, задания, выгрузки\&quot;, \&quot;Асинхронный обмен; семантика доставки неоднородна\&quot;)\n\n  Container(admin_tools, \&quot;Admin / Support tools\&quot;, \&quot;Web\&quot;, \&quot;Ручные проверки, корректировки статусов, служебные комментарии\&quot;)\n}\n\n&#39; ============================================================\n&#39; СВЯЗИ: КЛИЕНТСКИЕ И КАНАЛЬНЫЕ\n&#39; ============================================================\nRel(customer, channels, \&quot;Оформляет заказ,\\nсмотрит статус\&quot;, \&quot;HTTPS\&quot;)\nRel(channels, orderapi, \&quot;create / update order\&quot;, \&quot;REST, синхронно\&quot;)\nRel(marketplaces, orderapi, \&quot;Заказы, обновления, статусы\&quot;, \&quot;REST / batch\&quot;)\n\n&#39; ============================================================\n&#39; СВЯЗИ ВНУТРИ МОНОЛИТА\n&#39; ============================================================\nRel(orderapi, pricing, \&quot;Расчёт цены, скидок, промо\&quot;, \&quot;in-process\&quot;)\nRel(orderapi, processing, \&quot;Создание заказа\&quot;, \&quot;in-process\&quot;)\nRel(processing, payment_orch, \&quot;Инициация оплаты\&quot;, \&quot;in-process, синхронно\&quot;)\nRel(processing, delivery_routing, \&quot;Выбор доставки\&quot;, \&quot;in-process, синхронно\&quot;)\n\n&#39; ============================================================\n&#39; ВНЕШНИЕ ИНТЕГРАЦИИ\n&#39; ============================================================\nRel(payment_orch, payments, \&quot;Создание платёжной сессии\&quot;, \&quot;REST, синхронно\&quot;)\nRel(delivery_routing, delivery, \&quot;Резервирование слота\&quot;, \&quot;REST / смешанно\&quot;)\n\n&#39; ============================================================\n&#39; СВЯЗЬ С ORACLE\n&#39; ============================================================\nRel(pricing, oracle, \&quot;Правила, коэффициенты, legacy-промо\&quot;, \&quot;JDBC / packages\&quot;)\nRel(processing, oracle, \&quot;Заказ, резерв, служебные таблицы, staging\&quot;, \&quot;JDBC\&quot;)\nRel(statuses, oracle, \&quot;Статусы, история, технические состояния\&quot;, \&quot;JDBC / batch\&quot;)\nRel(payment_orch, oracle, \&quot;payment_session_id, технические атрибуты\&quot;, \&quot;JDBC\&quot;)\nRel(delivery_routing, oracle, \&quot;Правила маршрутизации, партнёры, retry-состояния\&quot;, \&quot;JDBC\&quot;)\n\n&#39; ============================================================\n&#39; ASYNC / BATCH\n&#39; ============================================================\nRel(processing, async_layer, \&quot;События, задания, выгрузки\&quot;, \&quot;async / batch\&quot;)\nRel(async_layer, dotnet, \&quot;Обмен для части партнёрских сценариев\&quot;, \&quot;queue / batch\&quot;)\nRel(dotnet, oracle, \&quot;staging / shared tables\&quot;, \&quot;обмен через БД\&quot;)\nRel(dotnet, delivery, \&quot;Партнёрские логистические интеграции\&quot;, \&quot;REST / batch\&quot;)\nRel(async_layer, python_jobs, \&quot;batch / async данные\&quot;, \&quot;batch\&quot;)\n\n&#39; ============================================================\n&#39; АНАЛИТИКА\n&#39; ============================================================\nRel(python_jobs, oracle, \&quot;Прямые выборки, витрины, долгие отчёты\&quot;, \&quot;SQL / batch\&quot;)\nRel(bi, oracle, \&quot;Отчётные запросы\&quot;, \&quot;SQL\&quot;)\nRel(business, bi, \&quot;Управленческие отчёты\&quot;, \&quot;UI\&quot;)\n\n&#39; ============================================================\n&#39; ПОДДЕРЖКА И АДМИНИСТРИРОВАНИЕ\n&#39; ============================================================\nRel(support, admin_tools, \&quot;Разбор обращений, ручные действия\&quot;, \&quot;UI\&quot;)\nRel(admin_tools, statuses, \&quot;Ручная проверка / корректировка статусов\&quot;, \&quot;UI / API\&quot;)\nRel(admin_tools, oracle, \&quot;Просмотр технических атрибутов\&quot;, \&quot;SQL\&quot;)\nRel(ops, delivery_routing, \&quot;Ручные настройки приоритетов\&quot;, \&quot;UI / config\&quot;)\n\n&#39; ============================================================\n&#39; ПРОБЛЕМНЫЕ ЗОНЫ (заметки)\n&#39; ============================================================\nnote right of orderapi\n  **Проблемная зона: Checkout**\n  — синхронные вызовы в критическом пути\n  — fallback с неполной бизнес-эквивалентностью\n  — высокая связность с Oracle\nend note\n\nnote bottom of pricing\n  **Проблемная зона: Pricing &amp; Promo**\n  — несколько механизмов расчёта\n  — правила в коде, конфигах и Oracle\n  — fallback на legacy_promo_pkg\nend note\n\nnote bottom of statuses\n  **Проблемная зона: Statuses**\n  — логика размазана по монолиту, batch и admin\n  — ручные корректировки\n  — расхождения между контурами\nend note\n\nnote bottom of oracle\n  **Критический узел: Oracle**\n  — операционные данные\n  — бизнес-логика (packages)\n  — интеграционный слой (staging)\n  — аналитическая нагрузка\n  — высокий порог изменений\nend note\n\nnote right of delivery_routing\n  **Проблемная зона: Логистика**\n  — нет единого интеграционного контура\n  — правила в коде, конфигах, Oracle\n  — ручные настройки приоритетов\n  — дубли и дедупликация неоднородны\nend note\n\nnote bottom of python_jobs\n  **Проблемная зона: Аналитика**\n  — нет канонической модели заказа\n  — прямые SQL к операционной Oracle\n  — разные трактовки в витринах\nend note\n\nnote top of dotnet\n  **Обмен через БД**\n  — staging / shared tables\n  — скрытая связанность\n  — риск побочных эффектов\nend note\n\nnote right of payments\n  Внешняя зависимость\n  — SLA и задержки не зафиксированы\n  — правила деградации отсутствуют\nend note\n\nnote right of delivery\n  Внешняя зависимость\n  — разные форматы интеграции\n  — разные SLA\n  — дубли и повторные заявки\nend note\n\nnote right of marketplaces\n  Внешняя зависимость\n  — вариативность каналов\n  — расхождение статусов\n  — специальные ветки поведения\nend note\n\nSHOW_LEGEND()\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DFjd-aZ3MQtQG-WG9RdF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
